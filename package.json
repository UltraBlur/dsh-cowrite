{
  "name": "dsh-cowrite",
  "version": "1.0.2",
  "type": "module",
  "description": "Markdown co-writing editor tab in the DSH right sidebar: live-editable document, instant save to the workspace, and automatic reload when the agent writes the same file.",
  "author": "UltraBlur",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    },
    "engines": {
      "dsh": ">=2.0.0"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "markdown",
    "editor",
    "live-preview",
    "typora",
    "writing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UltraBlur/dsh-cowrite.git"
  },
  "bugs": {
    "url": "https://github.com/UltraBlur/dsh-cowrite/issues"
  },
  "homepage": "https://github.com/UltraBlur/dsh-cowrite#readme"
}
